{
  "name": "dexpp-mcp",
  "version": "1.0.0",
  "description": "MCP server for Dex++ — drive a live Roblox client (explorer, scripts, remotes, GC, hooks) from an MCP client",
  "type": "module",
  "main": "server/index.js",
  "bin": { "dexpp-mcp": "server/index.js" },
  "scripts": {
    "start": "node server/index.js",
    "embed": "node scripts/embed.js",
    "check": "node scripts/check-lua.js",
    "docs": "node scripts/gen-docs.js",
    "build": "node scripts/embed.js && node scripts/check-lua.js && node scripts/gen-docs.js",
    "test": "node test/run.js && node test/lua-e2e.js"
  },
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "ws": "^8.22.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "fengari": "^0.1.5",
    "luaparse": "^0.3.1"
  }
}
